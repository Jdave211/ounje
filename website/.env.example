# Public project URL used for canonical and social metadata.
OUNJE_WEBSITE_URL=https://your-ounje-share-site.vercel.app

# Server-only Supabase configuration. Prefer a scoped, independently rotatable
# sb_secret_ key when one is available. Never prefix either key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=

# Legacy fallback for the project's current configuration.
SUPABASE_SERVICE_ROLE_KEY=
